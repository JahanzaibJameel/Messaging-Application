# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — client/src/lib/query-client.ts throws if EXPO_PUBLIC_DOMAIN is unset
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_DOMAIN=api.chatapp.com

EXPO_PUBLIC_API_URL=https://api.chatapp.com
EXPO_PUBLIC_WS_URL=wss://ws.chatapp.com/ws
EXPO_PUBLIC_USE_MOCK_AUTH=true
EXPO_PUBLIC_BACKEND_DOMAIN=api.chatapp.com
EXPO_PUBLIC_BACKEND_WS_DOMAIN=ws.chatapp.com

# Optional app metadata
EXPO_PUBLIC_APP_NAME=ChatApp
EXPO_PUBLIC_VERSION=3.0.0
EXPO_PUBLIC_BUILD_NUMBER=1

# Optional media upload endpoint (client/src/core/media/MediaUploader.ts)
EXPO_PUBLIC_UPLOAD_URL=https://api.chatapp.com/upload

# Optional monitoring
EXPO_PUBLIC_SENTRY_DSN=

# Comma-separated SHA-256 SPKI pins for the backend cert chain.
# REQUIRED for iOS/Android production builds; leave empty to fail fast.
# Do not commit real pins here and never ship a placeholder: a syntactically
# valid but unmatchable pin builds successfully and then fails every request.
# `npm run validate:env` rejects empty, malformed, and placeholder values.
# Generate with: openssl s_client -connect api.chatapp.com:443 -servername api.chatapp.com </dev/null 2>/dev/null \
#   | openssl x509 -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | openssl enc -base64
EXPO_PUBLIC_CERT_HASHES=

# Server-side only — never exposed to the client
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
JWT_SECRET=change-me-in-production-use-a-strong-random-string
JWT_REFRESH_SECRET=change-me-in-production-use-a-strong-random-string